<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <PackageId>BrutalSystems.Atlas</PackageId>
    <Authors>BrutalSystems</Authors>
    <Company>BrutalSystems</Company>
    <Description>Atlas application framework: data access, multi-tenancy and API plumbing for BrutalSystems services.</Description>
    <RepositoryUrl>https://github.com/BrutalSystems/atlas</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2026 BrutalSystems. All rights reserved.</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <IsPackable>true</IsPackable>     
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU</Platforms>     
    <Version>0.2.13</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="9.3.0" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.1" />
    <PackageReference Include="ByteAether.Ulid" Version="1.3.7" />
    <PackageReference Include="Foundatio" Version="13.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.2" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.10.0" />
    <!-- Pinned past their advisories; both come in transitively at vulnerable versions. Drop a pin once the packages
         that bring it in (Microsoft.Identity.Web, Microsoft.Data.SqlClient) depend on a fixed version.
         - System.Security.Cryptography.Xml 10.0.9 (Identity.Web → Data Protection): fixed in 10.0.10 (CVE-2026-50648 and others).
         - System.Security.Cryptography.Pkcs 10.0.7 (Identity.Web, SqlClient): GHSA-846f-f764-76mx. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <!-- .NET 10 prunes package references to assemblies the ASP.NET Core framework ships, and a pruned reference is left
       out of the packed .nuspec: 0.2.12 shipped without its Cryptography.Xml pin, so apps using Atlas still got the
       vulnerable version through Identity.Web. With pruning off, the pins below reach every app that uses Atlas. -->
  <PropertyGroup>
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Atlas.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
